# Produção (Hetzner)
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_ALLOWED_HOSTS=aguiacafe.com.br,www.aguiacafe.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://aguiacafe.com.br,https://www.aguiacafe.com.br

# Mantenha False até o certificado HTTPS estar ativo.
DJANGO_SECURE_SSL_REDIRECT=False

# Comece com 0. Depois que HTTPS estiver estável, pode aumentar.
DJANGO_SECURE_HSTS_SECONDS=0

# Banco de dados
# Localmente, omita estas variáveis para continuar usando SQLite.
# Em produção, use os dados fornecidos pelo konsoleH.
DJANGO_DB_ENGINE=postgresql
DB_NAME=nome_do_banco
DB_USER=usuario_do_banco
DB_PASSWORD=troque-pela-senha-do-banco
DB_HOST=hostname-fornecido-pela-hetzner
DB_PORT=5432
# Preencha somente se você habilitar "Require SSL" no PostgreSQL do konsoleH.
# DB_SSLMODE=require
